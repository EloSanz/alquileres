generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Tenant {
  id                  Int         @id @default(autoincrement())
  firstName           String
  lastName            String
  phone               String?
  documentId          String      @unique
  numeroLocal         String?
  rubro               Rubro?
  fechaInicioContrato DateTime?
  estadoPago          EstadoPago  @default(AL_DIA)
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  contracts           Contract[]
  guarantees          Guarantee[]
  payments            Payment[]
  properties          Property[]
  rentals             Rental[]

  @@map("tenants")
}

model Property {
  id           Int            @id @default(autoincrement())
  localNumber  Int
  ubicacion    UbicacionType  @default(BOULEVAR)
  monthlyRent  Decimal
  status       PropertyStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenantId     Int?
  contracts    Contract[]
  guarantees   Guarantee[]
  maintenances Maintenance[]
  payments     Payment[]
  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  rentals      Rental[]
  services     Service[]
  taxes        Tax[]

  @@map("properties")
}

model Rental {
  id            Int          @id @default(autoincrement())
  tenantId      Int
  propertyId    Int
  startDate     DateTime
  endDate       DateTime?
  monthlyRent   Decimal
  depositAmount Decimal?
  status        RentalStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId, startDate])
  @@map("rentals")
}

model Contract {
  id             Int            @id @default(autoincrement())
  tenantId       Int?
  propertyId     Int?
  tenantFullName String?
  startDate      DateTime
  endDate        DateTime
  monthlyRent    Decimal
  status         ContractStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  property       Property?      @relation(fields: [propertyId], references: [id])
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  guarantees     Guarantee[]
  maintenances   Maintenance[]
  payments       Payment[]
  services       Service[]
  taxes          Tax[]

  @@map("contracts")
}

model Payment {
  id                   Int           @id @default(autoincrement())
  tenantId             Int?
  propertyId           Int?
  contractId           Int?
  monthNumber          Int?
  tenantFullName       String?
  tenantPhone          String?
  amount               Decimal
  paymentDate          DateTime      @default(now())
  dueDate              DateTime
  paymentMethod        PaymentMethod @default(YAPE)
  status               PaymentStatus @default(FUTURO)
  pentamontSettled     Boolean       @default(false)
  notes                String?
  receiptImageUrl      String?
  receiptImagePublicId String?
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  contract             Contract?     @relation(fields: [contractId], references: [id])
  property             Property?     @relation(fields: [propertyId], references: [id])
  tenant               Tenant?       @relation(fields: [tenantId], references: [id])

  @@unique([contractId, monthNumber])
  @@map("payments")
}

model Service {
  id          Int         @id @default(autoincrement())
  propertyId  Int?
  contractId  Int?
  serviceType ServiceType @default(AGUA)
  amount      Decimal
  dueDate     DateTime
  paidDate    DateTime?
  isPaid      Boolean     @default(false)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  contract    Contract?   @relation(fields: [contractId], references: [id])
  property    Property?   @relation(fields: [propertyId], references: [id])

  @@map("services")
}

model ContractDraft {
  id        Int      @id @default(autoincrement())
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_drafts")
}

model Tax {
  id         Int       @id @default(autoincrement())
  propertyId Int?
  contractId Int?
  taxType    TaxType   @default(PREDIAL)
  amount     Decimal
  dueDate    DateTime
  paidDate   DateTime?
  isPaid     Boolean   @default(false)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  contract   Contract? @relation(fields: [contractId], references: [id])
  property   Property? @relation(fields: [propertyId], references: [id])

  @@map("taxes")
}

model Guarantee {
  id            Int           @id @default(autoincrement())
  propertyId    Int?
  contractId    Int?
  tenantId      Int?
  guaranteeType GuaranteeType @default(DEPOSITO)
  amount        Decimal
  depositDate   DateTime      @default(now())
  returnDate    DateTime?
  isReturned    Boolean       @default(false)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contract      Contract?     @relation(fields: [contractId], references: [id])
  property      Property?     @relation(fields: [propertyId], references: [id])
  tenant        Tenant?       @relation(fields: [tenantId], references: [id])

  @@map("guarantees")
}

model Maintenance {
  id              Int               @id @default(autoincrement())
  propertyId      Int?
  contractId      Int?
  maintenanceType MaintenanceType   @default(REPARACION)
  description     String
  estimatedCost   Decimal?
  actualCost      Decimal?
  scheduledDate   DateTime?
  completedDate   DateTime?
  status          MaintenanceStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  contract        Contract?         @relation(fields: [contractId], references: [id])
  property        Property?         @relation(fields: [propertyId], references: [id])

  @@map("maintenances")
}

model PatioTenant {
  id             Int            @id @default(autoincrement())
  nombre         String
  nombreComercial String?
  razonSocial     String?
  apodo          String?
  numerosLocales String
  telefono       String?
  rubro          String?
  montoAlquiler   Decimal?
  fechaIngreso   DateTime?
  estadoPago     EstadoPago     @default(AL_DIA)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  pagos          PatioPayment[]

  @@map("patio_tenants")
}

model PatioPayment {
  id               Int           @id @default(autoincrement())
  patioTenantId    Int
  monto            Decimal
  fechaPago        DateTime      @default(now())
  fechaVencimiento DateTime
  metodoPago       PaymentMethod @default(YAPE)
  estado           PaymentStatus @default(FUTURO)
  notas            String?
  pentamontSettled Boolean       @default(false)
  receiptImageUrl      String?
  receiptImagePublicId String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  patioTenant      PatioTenant   @relation(fields: [patioTenantId], references: [id])

  @@map("patio_payments")
}

enum UbicacionType {
  BOULEVAR
  SAN_MARTIN
  PATIO
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EstadoPago {
  AL_DIA
  CON_DEUDA
}

enum Rubro {
  TIPEO
  PEDICURE
}

enum RentalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  TERMINATED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  TERMINATED
}

enum PaymentMethod {
  YAPE
  DEPOSITO
  TRANSFERENCIA_VIRTUAL
}

enum PaymentStatus {
  PAGADO
  VENCIDO
  FUTURO
}

enum ServiceType {
  AGUA
  LUZ
  ARBITRIOS
}

enum TaxType {
  PREDIAL
  MUNICIPAL
  ALCABALA
  OTROS
}

enum GuaranteeType {
  DEPOSITO
  FIANZA
  SEGURO
  OTROS
}

enum MaintenanceType {
  REPARACION
  LIMPIEZA
  PINTURA
  ELECTRICIDAD
  PLOMERIA
  JARDINERIA
  OTROS
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
